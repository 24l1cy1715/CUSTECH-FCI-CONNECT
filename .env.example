# ── Database Connection (MySQL via XAMPP or local server) ─────────────────────
DATABASE_URL="mysql://root:@localhost:3306/custech_fci_connect"

# ── JWT Authentication Secrets (min 32 chars) ──────────────────────────────────
AUTH_SECRET="your-secure-auth-secret-min-32-chars-change-me"
REFRESH_SECRET="your-secure-refresh-secret-min-32-chars-change-me"

# ── Application URLs ──────────────────────────────────────────────────────────
APP_URL="http://localhost:5173"
API_URL="http://localhost:5000"
PORT="5000"
NODE_ENV="development"

# ── Google OAuth (Optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR="../uploads"
MAX_FILE_SIZE_MB="10"

# ── Email Service (Brevo SMTP) ───────────────────────────────────────────────
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER=""
BREVO_SMTP_KEY=""
EMAIL_FROM="no-reply@custech.edu.ng"
EMAIL_FROM_NAME="CUSTECH FCI Connect"

# ── Client / Tawk.to AI Live Support Widget ──────────────────────────────────
# Configure these in client/.env (Vite client-side variables)
VITE_TAWK_PROPERTY_ID=""
VITE_TAWK_WIDGET_ID=""
