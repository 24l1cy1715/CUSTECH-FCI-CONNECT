model LearningResource {
  id              String                   @id @default(uuid()) @db.VarChar(36)
  title           String                   @db.VarChar(255)
  slug            String                   @unique @db.VarChar(255)
  description     String?                  @db.Text
  resourceType    LearningResourceType     @map("resource_type")
  category        LearningResourceCategory
  subject         String?                  @db.VarChar(255) // e.g. Data Structures & Algorithms
  courseCode      String?                  @map("course_code") @db.VarChar(50) // e.g. CSC 301
  department      Department?
  level           Level?
  semester        String?                  @db.VarChar(20) // e.g. FIRST, SECOND
  url             String?                  @db.VarChar(1000)
  fileUrl         String?                  @map("file_url") @db.VarChar(1000)
  fileSize        Int?                     @map("file_size")
  mimeType        String?                  @map("mime_type") @db.VarChar(100)
  thumbnail       String?                  @db.VarChar(1000)
  authorId        String?                  @map("author_id") @db.VarChar(36)
  status          ResourceSubmissionStatus @default(APPROVED)
  rejectionReason String?                  @map("rejection_reason") @db.Text
  isPublished     Boolean                  @default(true) @map("is_published")
  isFeatured      Boolean                  @default(false) @map("is_featured")
  viewsCount      Int                      @default(0) @map("views_count")
  downloadsCount  Int                      @default(0) @map("downloads_count")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  author    User?                      @relation("AuthorLearningResources", fields: [authorId], references: [id], onDelete: SetNull)
  progress  LearningResourceProgress[]
  pathItems LearningPathItem[]
  skills    LearningResourceSkill[]
  labProjectResources LabProjectResource[]

  @@index([category])
  @@index([resourceType])
  @@index([courseCode])
  @@index([department])
  @@index([level])
  @@index([status])
  @@index([isPublished])
  @@index([isFeatured])
  @@map("learning_resources")
}

model LearningResourceProgress {
  id                 String                 @id @default(uuid()) @db.VarChar(36)
  userId             String                 @map("user_id") @db.VarChar(36)
  resourceId         String                 @map("resource_id") @db.VarChar(36)
  status             LearningProgressStatus @default(IN_PROGRESS)
  progressPercentage Int                    @default(0) @map("progress_percentage") // 0 - 100
  startedAt          DateTime               @default(now()) @map("started_at")
  completedAt        DateTime?              @map("completed_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId])
  @@index([resourceId])
  @@index([status])
  @@map("learning_resource_progress")
}

model LearningPath {
  id                String                   @id @default(uuid()) @db.VarChar(36)
  title             String                   @db.VarChar(255)
  slug              String                   @unique @db.VarChar(255)
  description       String                   @db.Text
  category          LearningResourceCategory
  difficulty        LearningPathDifficulty   @default(BEGINNER)
  estimatedDuration String?                  @map("estimated_duration") @db.VarChar(100)
  thumbnail         String?                  @db.VarChar(1000)
  isPublished       Boolean                  @default(true) @map("is_published")
  isFeatured        Boolean                  @default(false) @map("is_featured")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  items       LearningPathItem[]
  enrollments LearningPathEnrollment[]

  @@index([category])
  @@index([difficulty])
  @@index([isPublished])
  @@map("learning_paths")
}

model LearningPathItem {
  id             String   @id @default(uuid()) @db.VarChar(36)
  learningPathId String   @map("learning_path_id") @db.VarChar(36)
  resourceId     String   @map("resource_id") @db.VarChar(36)
  position       Int      @default(0)
  isRequired     Boolean  @default(true) @map("is_required")
  createdAt      DateTime @default(now()) @map("created_at")

  learningPath LearningPath     @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  resource     LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([learningPathId, resourceId])
  @@index([learningPathId, position])
  @@map("learning_path_items")
}

model LearningPathEnrollment {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  userId             String    @map("user_id") @db.VarChar(36)
  learningPathId     String    @map("learning_path_id") @db.VarChar(36)
  progressPercentage Int       @default(0) @map("progress_percentage")
  isCompleted        Boolean   @default(false) @map("is_completed")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  @@unique([userId, learningPathId])
  @@index([userId])
  @@index([learningPathId])
  @@map("learning_path_enrollments")
}

model LearningResourceSkill {
  id         String   @id @default(uuid()) @db.VarChar(36)
  resourceId String   @map("resource_id") @db.VarChar(36)
  skillId    String   @map("skill_id") @db.VarChar(36)
  createdAt  DateTime @default(now()) @map("created_at")

  resource LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  skill    Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([resourceId, skillId])
  @@index([skillId])
  @@map("learning_resource_skills")
}

model DigitalIdentity {
  id               String          @id @default(uuid()) @db.VarChar(36)
  userId           String          @unique @map("user_id") @db.VarChar(36)
  fciId            String          @unique @map("fci_id") @db.VarChar(64)
  verificationToken String         @unique @map("verification_token") @db.VarChar(128)
  status           DigitalIdStatus @default(PENDING)
