generator client {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                     @id @default(uuid()) @db.VarChar(36)
  email                     String                     @unique @db.VarChar(255)
  passwordHash              String?                    @map("password_hash") @db.VarChar(255)
  googleId                  String?                    @unique @map("google_id") @db.VarChar(255)
  emailVerified             Boolean                    @default(false) @map("email_verified")
  verifyToken               String?                    @map("verify_token") @db.VarChar(255)
  resetToken                String?                    @map("reset_token") @db.VarChar(255)
  resetExpires              DateTime?                  @map("reset_expires")
  isActive                  Boolean                    @default(true) @map("is_active")
  isSuspended               Boolean                    @default(false) @map("is_suspended")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  activityFeed              ActivityFeed[]
  announcementReads         AnnouncementRead[]
  announcements             Announcement[]
  assessmentAttempts        AssessmentAttempt[]
  auditLogs                 AuditLog[]
  businesses                Business[]
  comments                  Comment[]
  ownedCommunities          Community[]                @relation("CommunityOwner")
  communityMemberships      CommunityMembership[]
  communityComments         CommunityPostComment[]
  communityLikes            CommunityPostLike[]
  communityPosts            CommunityPost[]
  communityResources        CommunityResource[]
  connectionsReceived       ConnectionRequest[]        @relation("ReceiverUser")
  connectionsSent           ConnectionRequest[]        @relation("SenderUser")
  connectionsAsA            Connection[]               @relation("UserA")
  connectionsAsB            Connection[]               @relation("UserB")
  copilotConversations      CopilotConversation[]
  copilotFeedback           CopilotFeedback[]
  copilotUsage              CopilotUsage[]
  digitalIdentity           DigitalIdentity?           @relation("UserDigitalIdentity")
  verifiedDigitalIdentities DigitalIdentity[]          @relation("VerifierDigitalIdentity")
  eventRegistrations        EventRegistration[]
  organizedEvents           Event[]                    @relation("EventOrganizer")
  labDiscussions            LabProjectDiscussion[]
  labProjectMemberships     LabProjectMember[]
  addedLabResources         LabProjectResource[]
  assignedLabTasks          LabProjectTask[]           @relation("AssignedLabTasks")
  createdLabTasks           LabProjectTask[]           @relation("CreatedLabTasks")
  createdLabProjects        LabProject[]               @relation("CreatedLabProjects")
  mentoredLabProjects       LabProject[]               @relation("MentoredLabProjects")
  leaderboardPoints         LeaderboardPoint[]
  learningPathEnrollments   LearningPathEnrollment[]
  learningResourceProgress  LearningResourceProgress[]
  uploadedLearningResources LearningResource[]         @relation("AuthorLearningResources")
  marketplaceInquiries      MarketplaceInquiry[]
  marketplaceServices       MarketplaceService[]
  mentorProfile             MentorProfile?
  sharedMentorshipResources MentorshipResource[]
  menteeMentorships         Mentorship[]               @relation("MenteeMentorships")
  mentorMentorships         Mentorship[]               @relation("MentorMentorships")
  newsArticles              NewsArticle[]
  notifications             Notification[]
  createdOpportunities      Opportunity[]              @relation("CreatedOpportunities")
  opportunityApplications   OpportunityApplication[]
  opportunityReports        OpportunityReport[]
  passwordResetOtps         PasswordResetOtp[]
  profile                   Profile?
  projectLikes              ProjectLike[]
  teamMemberships           ProjectTeamMember[]
  projectTeams              ProjectTeam[]              @relation("TeamCreator")
  projects                  Project[]
  reportsFiled              Report[]                   @relation("ReporterUser")
  reportsResolved           Report[]                   @relation("ResolverUser")
  reputationEvents          ReputationEvent[]
  researchIdeaComments      ResearchIdeaComment[]
  researchIdeaLikes         ResearchIdeaLike[]
  researchIdeas             ResearchIdea[]
  researchMemberships       ResearchMember[]
  mentoredResearchProjects  ResearchProject[]          @relation("MentoredResearchProjects")
  ownedResearchProjects     ResearchProject[]          @relation("OwnedResearchProjects")
  roommateListing           RoommateListing[]
  savedItems                SavedItem[]
  savedOpportunities        SavedOpportunity[]
  savedRoommates            SavedRoommate[]
  supervisedPlacements      SiwesPlacement[]           @relation("AcademicSupervisorPlacements")
  studentPlacements         SiwesPlacement[]           @relation("StudentPlacements")
  studentSkills             StudentSkill[]
  receivedInvitations       TeamInvitation[]           @relation("ReceivedInvitations")
  sentInvitations           TeamInvitation[]           @relation("SentInvitations")
  userAchievements          UserAchievement[]          @relation("UserAchievements")
  verifiedAchievements      UserAchievement[]          @relation("VerifiedAchievements")
  githubProfile             UserGithubProfile?
  userRoles                 UserRole[]
  voicePollVotes            VoicePollVote[]
  voicePolls                VoicePoll[]
  voiceSuggestionVotes      VoiceSuggestionVote[]
  voiceSuggestions          VoiceSuggestion[]

  @@map("users")
}

model Profile {
  id                  String            @id @default(uuid()) @db.VarChar(36)
  userId              String            @unique @map("user_id") @db.VarChar(36)
  username            String            @unique @db.VarChar(50)
  fullName            String            @map("full_name") @db.VarChar(100)
  matricId            String?           @unique @map("matric_id") @db.VarChar(50)
  department          Department?
  level               Level?
  avatarUrl           String?           @map("avatar_url") @db.VarChar(500)
  bio                 String?           @db.Text
  githubUrl           String?           @map("github_url") @db.VarChar(500)
  linkedinUrl         String?           @map("linkedin_url") @db.VarChar(500)
  portfolioUrl        String?           @map("portfolio_url") @db.VarChar(500)
  skills              String?           @db.LongText
  interests           String?           @db.LongText
  communityPoints     Int               @default(0) @map("community_points")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  customSections      String?           @map("custom_sections") @db.LongText
  headline            String?           @db.VarChar(255)
  location            String?           @db.VarChar(100)
  portfolioBio        String?           @map("portfolio_bio") @db.Text
  portfolioViewsCount Int               @default(0) @map("portfolio_views_count")
  visibility          ProfileVisibility @default(PUBLIC)
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Role {
  id              String           @id @default(uuid()) @db.VarChar(36)
  name            RoleName         @unique
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.VarChar(36)
  name            String           @unique @db.VarChar(100)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.VarChar(36)
  roleId String @map("role_id") @db.VarChar(36)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId], map: "user_roles_role_id_fkey")
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.VarChar(36)
  permissionId String     @map("permission_id") @db.VarChar(36)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permission_id_fkey")
  @@map("role_permissions")
}

model Connection {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userAId   String   @map("user_a_id") @db.VarChar(36)
  userBId   String   @map("user_b_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")
  userA     User     @relation("UserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("UserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId], map: "connections_user_b_id_fkey")
  @@map("connections")
}

model ConnectionRequest {
  id         String                  @id @default(uuid()) @db.VarChar(36)
  senderId   String                  @map("sender_id") @db.VarChar(36)
  receiverId String                  @map("receiver_id") @db.VarChar(36)
  status     ConnectionRequestStatus @default(PENDING)
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")
  receiver   User                    @relation("ReceiverUser", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User                    @relation("SenderUser", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId], map: "connection_requests_receiver_id_fkey")
  @@map("connection_requests")
}

model Technology {
  id                  String              @id @default(uuid()) @db.VarChar(36)
  name                String              @unique @db.VarChar(100)
  projectTechnologies ProjectTechnology[]

  @@map("technologies")
}

model Project {
  id                  String              @id @default(uuid()) @db.VarChar(36)
  slug                String              @unique @db.VarChar(255)
  title               String              @db.VarChar(255)
  description         String?             @db.Text
  category            ProjectCategory
  githubUrl           String?             @map("github_url") @db.VarChar(500)
  demoUrl             String?             @map("demo_url") @db.VarChar(500)
  authorId            String              @map("author_id") @db.VarChar(36)
  status              ProjectStatus       @default(PENDING)
  views               Int                 @default(0)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  communityId         String?             @map("community_id") @db.VarChar(36)
  comments            Comment[]
  labProject          LabProject?         @relation("LabShowcaseProject")
  images              ProjectImage[]
  likes               ProjectLike[]
  skills              ProjectSkill[]
  projectTeam         ProjectTeam?
  projectTechnologies ProjectTechnology[]
  author              User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community           Community?          @relation(fields: [communityId], references: [id])
  teamInvitations     TeamInvitation[]

  @@index([authorId])
  @@index([status])
  @@index([category])
  @@index([communityId])
  @@map("projects")
}

model ProjectImage {
  id         String  @id @default(uuid()) @db.VarChar(36)
  projectId  String  @map("project_id") @db.VarChar(36)
  url        String  @db.VarChar(500)
  orderIndex Int     @default(0) @map("order_index")
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "project_images_project_id_fkey")
  @@map("project_images")
}

model ProjectTechnology {
  projectId    String     @map("project_id") @db.VarChar(36)
  technologyId String     @map("technology_id") @db.VarChar(36)
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([technologyId], map: "project_technologies_technology_id_fkey")
  @@map("project_technologies")
}

model ProjectLike {
  id        String   @id @default(uuid()) @db.VarChar(36)
  projectId String   @map("project_id") @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId], map: "project_likes_user_id_fkey")
  @@map("project_likes")
}

model Comment {
  id         String            @id @default(uuid()) @db.VarChar(36)
  authorId   String            @map("author_id") @db.VarChar(36)
  entityType CommentEntityType @map("entity_type")
  entityId   String            @map("entity_id") @db.VarChar(36)
  content    String            @db.Text
  isHidden   Boolean           @default(false) @map("is_hidden")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  author     User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project    Project           @relation(fields: [entityId], references: [id], onDelete: Cascade, map: "fk_comment_project")

  @@index([entityType, entityId])
  @@index([authorId], map: "comments_author_id_fkey")
  @@index([entityId], map: "fk_comment_project")
  @@map("comments")
}

model NewsCategory {
  id       String        @id @default(uuid()) @db.VarChar(36)
  name     String        @unique @db.VarChar(100)
  slug     String        @unique @db.VarChar(100)
  articles NewsArticle[]

  @@map("news_categories")
}

model NewsTag {
  id          String       @id @default(uuid()) @db.VarChar(36)
  name        String       @unique @db.VarChar(100)
  slug        String       @unique @db.VarChar(100)
  articleTags ArticleTag[]

  @@map("news_tags")
}

model NewsArticle {
  id          String        @id @default(uuid()) @db.VarChar(36)
  slug        String        @unique @db.VarChar(255)
  title       String        @db.VarChar(255)
  excerpt     String?       @db.Text
  content     String?       @db.LongText
  coverImage  String?       @map("cover_image") @db.VarChar(500)
  categoryId  String?       @map("category_id") @db.VarChar(36)
  authorId    String        @map("author_id") @db.VarChar(36)
  status      NewsStatus    @default(DRAFT)
  isFeatured  Boolean       @default(false) @map("is_featured")
  readingTime Int           @default(0) @map("reading_time")
  views       Int           @default(0)
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  articleTags ArticleTag[]
  author      User          @relation(fields: [authorId], references: [id])
  category    NewsCategory? @relation(fields: [categoryId], references: [id])

  @@index([slug])
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId], map: "news_articles_author_id_fkey")
  @@map("news_articles")
}

model ArticleTag {
  articleId String      @map("article_id") @db.VarChar(36)
  tagId     String      @map("tag_id") @db.VarChar(36)
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       NewsTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId], map: "article_tags_tag_id_fkey")
  @@map("article_tags")
}

model RoommateListing {
  id                String            @id @default(uuid()) @db.VarChar(36)
  ownerId           String            @map("owner_id") @db.VarChar(36)
  title             String            @db.VarChar(255)
  location          String            @db.VarChar(255)
  budgetMin         Decimal?          @map("budget_min") @db.Decimal(10, 2)
  budgetMax         Decimal?          @map("budget_max") @db.Decimal(10, 2)
  roomType          RoomType          @map("room_type")
  availableFrom     DateTime?         @map("available_from") @db.Date
  preferences       String?           @db.LongText
  description       String?           @db.Text
  contactPreference ContactPreference @default(PLATFORM) @map("contact_preference")
  status            ListingStatus     @default(ACTIVE)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  owner             User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  savedRoommates    SavedRoommate[]

  @@index([ownerId])
  @@index([status])
  @@map("roommate_listings")
}

model SavedRoommate {
  id        String          @id @default(uuid()) @db.VarChar(36)
  userId    String          @map("user_id") @db.VarChar(36)
  listingId String          @map("listing_id") @db.VarChar(36)
  createdAt DateTime        @default(now()) @map("created_at")
  listing   RoommateListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId], map: "saved_roommates_listing_id_fkey")
  @@map("saved_roommates")
}

model Business {
  id          String            @id @default(uuid()) @db.VarChar(36)
  slug        String            @unique @db.VarChar(255)
  name        String            @db.VarChar(255)
  logoUrl     String?           @map("logo_url") @db.VarChar(500)
  description String?           @db.Text
  category    BusinessCategory
  phone       String?           @db.VarChar(20)
  email       String?           @db.VarChar(255)
  website     String?           @db.VarChar(500)
  location    String?           @db.VarChar(255)
  ownerId     String            @map("owner_id") @db.VarChar(36)
  status      BusinessStatus    @default(PENDING)
  socialLinks String?           @map("social_links") @db.LongText
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  images      BusinessImage[]
  services    BusinessService[]
  owner       User              @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([status])
  @@map("businesses")
}

model BusinessService {
  id          String   @id @default(uuid()) @db.VarChar(36)
  businessId  String   @map("business_id") @db.VarChar(36)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId], map: "business_services_business_id_fkey")
  @@map("business_services")
}

model BusinessImage {
  id         String   @id @default(uuid()) @db.VarChar(36)
  businessId String   @map("business_id") @db.VarChar(36)
  url        String   @db.VarChar(500)
  orderIndex Int      @default(0) @map("order_index")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId], map: "business_images_business_id_fkey")
  @@map("business_images")
}

model Event {
  id              String              @id @default(uuid()) @db.VarChar(36)
  title           String              @db.VarChar(255)
  description     String?             @db.Text
  eventType       EventType           @map("event_type")
  date            DateTime
  endDate         DateTime?           @map("end_date")
  location        String?             @db.VarChar(255)
  organizerId     String              @map("organizer_id") @db.VarChar(36)
  coverImage      String?             @map("cover_image") @db.VarChar(500)
  registrationUrl String?             @map("registration_url") @db.VarChar(500)
  maxAttendees    Int?                @map("max_attendees")
  status          EventStatus         @default(UPCOMING)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  communityId     String?             @map("community_id") @db.VarChar(36)
  registrations   EventRegistration[]
  community       Community?          @relation(fields: [communityId], references: [id])
  organizer       User                @relation("EventOrganizer", fields: [organizerId], references: [id])

  @@index([date])
  @@index([status])
  @@index([communityId])
  @@index([organizerId], map: "events_organizer_id_fkey")
  @@map("events")
}

model EventRegistration {
  id        String   @id @default(uuid()) @db.VarChar(36)
  eventId   String   @map("event_id") @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId], map: "event_registrations_user_id_fkey")
  @@map("event_registrations")
}

model Achievement {
  id               String              @id @default(uuid()) @db.VarChar(36)
  name             String              @unique @db.VarChar(100)
  description      String              @db.Text
  badgeIcon        String              @map("badge_icon") @db.VarChar(500)
  points           Int                 @default(0)
  category         AchievementCategory @default(FCI_CONNECT)
  createdAt        DateTime            @default(now()) @map("created_at")
  criteria         String?             @db.Text
  isActive         Boolean             @default(true) @map("is_active")
  slug             String              @unique @db.VarChar(100)
  updatedAt        DateTime            @updatedAt @map("updated_at")
  userAchievements UserAchievement[]

  @@index([category])
  @@index([isActive])
  @@map("achievements")
}

model UserAchievement {
  id              String                        @id @default(uuid()) @db.VarChar(36)
  userId          String                        @map("user_id") @db.VarChar(36)
  achievementId   String                        @map("achievement_id") @db.VarChar(36)
  earnedAt        DateTime                      @default(now()) @map("earned_at")
  createdAt       DateTime                      @default(now()) @map("created_at")
  evidenceNotes   String?                       @map("evidence_notes") @db.Text
  evidenceUrl     String?                       @map("evidence_url") @db.VarChar(500)
  issuer          String?                       @db.VarChar(100)
  rejectionReason String?                       @map("rejection_reason") @db.Text
  status          AchievementVerificationStatus @default(VERIFIED)
  updatedAt       DateTime                      @updatedAt @map("updated_at")
  verifiedAt      DateTime?                     @map("verified_at")
  verifiedById    String?                       @map("verified_by_id") @db.VarChar(36)
  achievement     Achievement                   @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user            User                          @relation("UserAchievements", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy      User?                         @relation("VerifiedAchievements", fields: [verifiedById], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@index([status])
  @@index([verifiedById], map: "user_achievements_verified_by_id_fkey")
  @@map("user_achievements")
}

model ReputationEvent {
  id            String   @id @default(uuid()) @db.VarChar(36)
  userId        String   @map("user_id") @db.VarChar(36)
  eventType     String   @map("event_type") @db.VarChar(100)
  points        Int
  referenceType String?  @map("reference_type") @db.VarChar(50)
  referenceId   String?  @map("reference_id") @db.VarChar(36)
  description   String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("reputation_events")
}

model ReputationLevelConfig {
  id          String  @id @default(uuid()) @db.VarChar(36)
  levelName   String  @unique @map("level_name") @db.VarChar(50)
  minPoints   Int     @map("min_points")
  badgeIcon   String? @map("badge_icon") @db.VarChar(255)
  description String? @db.VarChar(255)
  orderIndex  Int     @default(0) @map("order_index")

  @@map("reputation_level_configs")
}

model LeaderboardPoint {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  action     String   @db.VarChar(100)
  points     Int
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(36)
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("leaderboard_points")
}

model Notification {
  id         String           @id @default(uuid()) @db.VarChar(36)
  userId     String           @map("user_id") @db.VarChar(36)
  type       NotificationType
  title      String           @db.VarChar(255)
  message    String           @db.Text
  entityType String?          @map("entity_type") @db.VarChar(50)
  entityId   String?          @map("entity_id") @db.VarChar(36)
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  DateTime         @default(now()) @map("created_at")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Report {
  id          String           @id @default(uuid()) @db.VarChar(36)
  reporterId  String           @map("reporter_id") @db.VarChar(36)
  entityType  ReportEntityType @map("entity_type")
  entityId    String           @map("entity_id") @db.VarChar(36)
  reason      ReportReason
  description String?          @db.Text
