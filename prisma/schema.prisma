// ── PHASE 8: RESEARCH & INNOVATION HUB ────────────────────────────────────────

model ResearchProject {
  id               String             @id @default(uuid()) @db.VarChar(36)
  title            String             @db.VarChar(255)
  slug             String             @unique @db.VarChar(255)
  description      String             @db.Text
  abstract         String?            @db.Text
  problemStatement String?            @map("problem_statement") @db.Text
  objectives       String?            @db.Text
  methodology      String?            @db.Text
  category         String             @db.VarChar(100)
  department       Department?
  researchStatus   ResearchStatus     @default(IDEA) @map("research_status")
  visibility       ResearchVisibility @default(PUBLIC)
  ownerId          String             @map("owner_id") @db.VarChar(36)
  mentorId         String?            @map("mentor_id") @db.VarChar(36)
  startDate        DateTime?          @map("start_date")
  targetDate       DateTime?          @map("target_date")
  githubUrl        String?            @map("github_url") @db.VarChar(500)
  paperUrl         String?            @map("paper_url") @db.VarChar(500)
  datasetUrl       String?            @map("dataset_url") @db.VarChar(500)
  publicationUrl   String?            @map("publication_url") @db.VarChar(500)
  coverImage       String?            @map("cover_image") @db.VarChar(500)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  owner        User                  @relation("OwnedResearchProjects", fields: [ownerId], references: [id], onDelete: Cascade)
  mentor       User?                 @relation("MentoredResearchProjects", fields: [mentorId], references: [id], onDelete: SetNull)
  members      ResearchMember[]
  publications ResearchPublication[]

  @@index([category])
  @@index([researchStatus])
  @@index([visibility])
  @@index([ownerId])
  @@map("research_projects")
}

model ResearchMember {
  id                String             @id @default(uuid()) @db.VarChar(36)
  researchProjectId String             @map("research_project_id") @db.VarChar(36)
  userId            String             @map("user_id") @db.VarChar(36)
  role              ResearchMemberRole @default(RESEARCHER)
  status            String             @default("ACTIVE") @db.VarChar(50)
  joinedAt          DateTime           @default(now()) @map("joined_at")

  project ResearchProject @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([researchProjectId, userId])
  @@index([userId])
  @@map("research_members")
}

model ResearchIdea {
  id          String   @id @default(uuid()) @db.VarChar(36)
