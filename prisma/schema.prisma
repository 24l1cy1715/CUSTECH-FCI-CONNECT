  visibility       LabProjectVisibility @default(FCI_ONLY)
  status           LabProjectStatus     @default(IDEA)
  startDate        DateTime?            @map("start_date")
  targetDate       DateTime?            @map("target_date")
  githubUrl        String?              @map("github_url") @db.VarChar(500)
  liveDemoUrl      String?              @map("live_demo_url") @db.VarChar(500)
  documentationUrl String?              @map("documentation_url") @db.VarChar(500)
  coverImage       String?              @map("cover_image") @db.VarChar(500)
