// ─────────────────────────────────────────────────────────────────────────────
// CUSTECH FCI CONNECT — Prisma Schema (MySQL 8+)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

