// ── PHASE 9: FCI SKILL ASSESSMENT CENTER ─────────────────────────────────────

model SkillAssessment {
  id                     String               @id @default(uuid()) @db.VarChar(36)
  title                  String               @db.VarChar(255)
  slug                   String               @unique @db.VarChar(255)
  description            String               @db.Text
  skillId                String?              @map("skill_id") @db.VarChar(36)
  category               String               @db.VarChar(100)
  difficulty             AssessmentDifficulty @default(INTERMEDIATE)
  timeLimitMinutes       Int                  @default(15) @map("time_limit_minutes")
  passingScorePercentage Int                  @default(70) @map("passing_score_percentage")
  status                 AssessmentStatus     @default(PUBLISHED)
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  skill     Skill?               @relation(fields: [skillId], references: [id], onDelete: SetNull)
  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  @@index([category])
  @@index([difficulty])
  @@index([status])
  @@map("skill_assessments")
}

model AssessmentQuestion {
  id                 String                 @id @default(uuid()) @db.VarChar(36)
  assessmentId       String                 @map("assessment_id") @db.VarChar(36)
  questionText       String                 @map("question_text") @db.Text
  questionType       AssessmentQuestionType @default(MULTIPLE_CHOICE) @map("question_type")
  options            Json                   // string[] of options
  correctOptionIndex Int                    @map("correct_option_index")
  explanation        String?                @db.Text
  points             Int                    @default(10)
  position           Int                    @default(0)

  assessment SkillAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId, position])
  @@map("assessment_questions")
}

model AssessmentAttempt {
  id               String    @id @default(uuid()) @db.VarChar(36)
  assessmentId     String    @map("assessment_id") @db.VarChar(36)
  userId           String    @map("user_id") @db.VarChar(36)
  scorePercentage  Int       @map("score_percentage")
  isPassed         Boolean   @map("is_passed")
  timeSpentSeconds Int       @map("time_spent_seconds")
  answersSubmitted Json?     @map("answers_submitted")
  completedAt      DateTime  @default(now()) @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  assessment SkillAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([userId])
  @@map("assessment_attempts")
}

