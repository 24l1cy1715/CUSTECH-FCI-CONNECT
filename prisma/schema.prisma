  verifiedById     String?         @map("verified_by_id") @db.VarChar(36)
  suspensionReason String?         @map("suspension_reason") @db.Text
  revocationReason String?         @map("revocation_reason") @db.Text
  showSkills       Boolean         @default(true) @map("show_skills")
  showAchievements Boolean         @default(true) @map("show_achievements")
  showPortfolio    Boolean         @default(true) @map("show_portfolio")
  qrCodeDataUrl    String?         @map("qr_code_data_url") @db.LongText
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  user       User              @relation("UserDigitalIdentity", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User?             @relation("VerifierDigitalIdentity", fields: [verifiedById], references: [id], onDelete: SetNull)
